{
  "name": "sergio-hvac",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "cross-env NODE_ENV=development node generate-env.mjs",
    "start": "ng serve",
    "dev:api": "node api/dev-server.cjs",
    "prebuild": "cross-env NODE_ENV=production node generate-env.mjs && node scripts/generate-sitemap.mjs",
    "build": "cross-env NODE_ENV=production ng build",
    "vercel:dev": "cross-env NODE_ENV=development node generate-env.mjs && concurrently \"node api/dev-server.cjs\" \"ng serve --port 4200\"",
    "vercel:build": "cross-env NODE_ENV=production node generate-env.mjs && node update-sitemap.mjs && ng build --configuration=production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:SergioHVAC": "node dist/sergio-hvac/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/platform-server": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@angular/ssr": "^19.0.0",
    "@angular/service-worker": "19.0.0",
    "@supabase/supabase-js": "^2.56.0",
    "express": "^4.18.2",
    "resend": "^6.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@fullhuman/postcss-purgecss": "^5.0.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "angular-cli-ghpages": "^2.0.3",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.1",
    "concurrently": "^9.0.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.6.2"
  }
}
